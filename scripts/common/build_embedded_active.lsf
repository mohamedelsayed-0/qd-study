# Build the planar QDs-in-perovskite comparison arm.
# Required caller variables:
#   span_x, span_y, t_act, t_au, t_mox, t_edt, t_sno2, t_fto
# Outputs:
#   z_active_bottom, z_active_top, device_height

reset_fdtd;
setnamed("QD-Pbs","enabled",0);

zb=0;
select("Au");
set("x",0); set("x span",span_x); set("y",0); set("y span",span_y);
set("z",zb+t_au/2); set("z span",t_au); zb=zb+t_au;
select("MOo3");
set("x",0); set("x span",span_x); set("y",0); set("y span",span_y);
set("z",zb+t_mox/2); set("z span",t_mox); zb=zb+t_mox;
select("p-PbS-EDT");
set("x",0); set("x span",span_x); set("y",0); set("y span",span_y);
set("z",zb+t_edt/2); set("z span",t_edt); zb=zb+t_edt;

z_active_bottom=zb;
select("Perovskite");
set("x",0); set("x span",span_x); set("y",0); set("y span",span_y);
set("z",zb+t_act/2); set("z span",t_act); zb=zb+t_act;
z_active_top=zb;

select("SnO2");
set("x",0); set("x span",span_x); set("y",0); set("y span",span_y);
set("z",zb+t_sno2/2); set("z span",t_sno2); zb=zb+t_sno2;
select("FTO");
set("x",0); set("x span",span_x); set("y",0); set("y span",span_y);
set("z",zb+t_fto/2); set("z span",t_fto); zb=zb+t_fto;
device_height=zb;

select("Glass");
set("x",0); set("x span",span_x); set("y",0); set("y span",span_y);
set("z",device_height+150e-9); set("z span",300e-9);
select("FDTD");
set("x",0); set("x span",span_x); set("y",0); set("y span",span_y);
set("z",(device_height+50e-9)/2); set("z span",device_height+450e-9);
select("PlaneWave");
set("x",0); set("x span",span_x); set("y",0); set("y span",span_y);
set("z",device_height+120e-9);
select("R");
set("x",0); set("x span",span_x); set("y",0); set("y span",span_y);
set("z",device_height+200e-9);
select("T");
set("x",0); set("x span",span_x); set("y",0); set("y span",span_y);
set("z",-100e-9);

select("P_pvk_top");
set("x",0); set("x span",span_x); set("y",0); set("y span",span_y);
set("z",z_active_top);
select("P_qd_edt");
set("x",0); set("x span",span_x); set("y",0); set("y span",span_y);
set("z",z_active_bottom);
setnamed("P_pvk_qd","enabled",0);
